<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous"> -->
    <link rel="stylesheet" href="/bootstrap.css">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <script src="https://d3js.org/d3.v6.min.js"></script>
    <script type="module" src="/dataLineageDashboardsScripts.js"></script>
</head>
<body>
    <div style="display: inline-flex; width: 100%">
        <div class="list-group" style="width: 300px; height: 100vh; overflow: auto; display: inline-block; width: 15%; resize: horizontal">

            <!-- section with search engine -->
            <form action="/data_lineage_dashboards/search" method="POST" style="margin-bottom: 20px">
                <div style="text-align: center;">
                    <label>Type in what you are looking for</label>
                </div>
                <div style="text-align: center;">
                    <input type="input" name="searchBar" style="width: 100%; margin-bottom: 10px" value ="<%= searchedQuery %>">
                    <button type="submit" name="actualUrl" value="<%= actualUrl %>">Search</button>
                </div>
            </form>

            <!-- section with data lineage documents list -->
            <% docs.forEach(doc => { %>
                <% if (selectedDoc == undefined) { %>
                    <div class="list-group-item list-group-item-action" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
                    <% if (searchedQuery != '') { %>
                        <a href="/data_lineage_dashboards/<%= doc.dataLineageId %>?searchedQuery=<%= searchedQuery %>">
                    <% } else { %>
                        <a href="/data_lineage_dashboards/<%= doc.dataLineageId %>">
                    <% } %>
                            <%= doc.dataLineageName %>
                        </a>
                    </div>
                    
                <% } else { %>
                    <% if (doc.dataLineageId == selectedDoc.dataLineageId) { %>
                        <div class="list-group-item list-group-item-action active" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
                            <% if (searchedQuery != '') { %>
                                <a href="/data_lineage_dashboards/<%= doc.dataLineageId %>?searchedQuery=<%= searchedQuery %>" style="color: white">
                            <% } else { %>
                                <a href="/data_lineage_dashboards/<%= doc.dataLineageId %>" style="color: white">
                            <% } %>
                    <% } else { %>
                        <div class="list-group-item list-group-item-action" style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">
                        <% if (searchedQuery != '') { %>
                            <a href="/data_lineage_dashboards/<%= doc.dataLineageId %>?searchedQuery=<%= searchedQuery %>">
                        <% } else { %>
                            <a href="/data_lineage_dashboards/<%= doc.dataLineageId %>">
                        <% } %>
                    <% } %>
                                <%= doc.dataLineageName %>
                            </a>
                        </div>
                <% } %>
            <% }) %>
        </div>

        <% if (selectedDoc != undefined) { %>
            <div style="display: inline-block; vertical-align: top; margin-top:20px; margin-left:20px; width: 80%">
                <!-- log out and home button -->
                <header>
                    <h1 style="display: inline"><%= selectedDoc.dataLineageName %></h1>
                    <form action="/logout?_method=DELETE" method="POST" style="display: inline">
                        <button type="submit" style="position: absolute; right: 5%">Log out</button>
                    </form>
                    <form action="/home" method="GET" style="display: inline">
                        <button type="submit" style="position: absolute; right: 10%">Home</button>
                    </form>
                </header>
        
                <!-- section with a data lineage graph -->
                <div id="dataLineageGraph" style="height: 80vh;"></div>

                <!-- popup window with additional info about table nodes -->
                <div class="modal fade" id="tableAdditionalInfo" tabindex="-1" role="dialog" aria-labelledby="exampleModalLongTitle" aria-hidden="true">
                    <div class="modal-dialog" role="document" style="max-width: 80%">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="modal_title">Modal title</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="white-space: pre-line; white-space: pre;"></div>
                        </div>
                    </div>
                </div>

                <!-- popup window with additional info about scripts -->
                <div class="modal fade" id="scriptAdditionalInfo" tabindex="-1" role="dialog" aria-labelledby="exampleModalLongTitle" aria-hidden="true">
                    <div class="modal-dialog" role="document" style="max-width: 80%">
                        <div class="modal-content">
                            <div class="modal-header">
                                <!-- <h5 class="modal-title" id="exampleModalLongTitle">Modal title</h5> -->
                                <h5 class="modal-title" id="modal_title">Modal title</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="white-space: pre-line; white-space: pre;"></div>
                        </div>
                    </div>
                </div>
            </div>
        <% } else { %>
            <!-- log out and home button -->
            <div style="display: inline-block; vertical-align: top; margin-top:20px; margin-left:20px; width: 80%">
                <header>
                    <form action="/logout?_method=DELETE" method="POST" style="display: inline">
                        <button type="submit" style="position: absolute; right: 5%">Log out</button>
                    </form>
                    <form action="/home" method="GET" style="display: inline">
                        <button type="submit" style="position: absolute; right: 10%">Home</button>
                    </form>
                </header>
            </div>
        <% } %>
    </div>
</body>
</html>